{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["uvx", "mcp-for-blender"],
      "enabled": true,
      "environment": { "BLENDER_PORT": "9877" }
    },
    "mediamcp": {
      "enabled": true
    },
    "playwright": {
      "enabled": false
    }
  }
}
